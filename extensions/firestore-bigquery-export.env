# Stream Firestore to BigQuery — mirrors the `users` collection (wellread DB)
# into BigQuery so we can compute real total-user-count and signup-growth
# metrics without relying on Amplitude's instrumented-user-only tracking.
DATASET_LOCATION=us
DATABASE=wellread
DATABASE_REGION=nam5
COLLECTION_PATH=users
WILDCARD_IDS=false
DATASET_ID=wellread_analytics
TABLE_ID=users
TABLE_PARTITIONING=NONE
MAX_DISPATCHES_PER_SECOND=100
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=no
EXCLUDE_OLD_DATA=no
MAX_ENQUEUE_ATTEMPTS=3
LOG_LEVEL=info
