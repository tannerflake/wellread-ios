rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any signed-in reader can read profiles (Other readers strip, feed, library). Write own doc only.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // FCM device tokens for push (written by the app after sign-in).
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // In-app notification feed (bell on the profile page). Created only by
      // Cloud Functions (Admin SDK bypasses rules); the owner reads, marks
      // read, and may clear rows.
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if false;
      }
    }

    // One doc per lowercase handle: { uid: "<firebase uid>" }.
    // Public read: availability checks must not depend on auth token + rules being deployed per-database;
    // writes are still protected. (Uid per handle is acceptable for a public @handle registry.)
    match /handleClaims/{handle} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Books: read anyone; create/update when authenticated
    match /books/{bookId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // UserBooks: signed-in users can read anyone’s library (viewing tiers/queue). Write own rows only.
    match /userBooks/{userBookId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Posts: read for feed; create when userId == auth.uid; update for likeCount/commentCount.
    // Exception: any signed-in user may create a bare `readRecord` discussion stub for
    // ANOTHER member's read (book profile "Read by" comments/likes on reads that were
    // never posted to the feed). Keys are locked to the empty-counter shape, so the
    // worst abuse is a harmless orphan doc that no surface ever renders.
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        (
          request.resource.data.type == 'readRecord'
          && request.resource.data.keys().hasOnly(['userId', 'type', 'bookId', 'createdAt', 'likeCount', 'commentCount'])
          && request.resource.data.likeCount == 0
          && request.resource.data.commentCount == 0
        )
      );
      allow update: if request.auth != null;  // e.g. likeCount, commentCount
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Comments: read with post; create when authenticated; delete own comment or (when deleting a post) the post author.
    // Anyone signed in may update likeCount alone (the like/unlike increment); everything else stays owner-only.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
      );
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.userId == request.auth.uid
      );
    }

    // Post likes: like doc id is "{uid}_{postId}"; delete own like or post author removing all likes for a post
    match /postLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.userId == request.auth.uid
      );
    }

    // Comment likes: like doc id is "{uid}_{commentId}"; create own like only.
    // Delete: your own like, or (when deleting a comment) the comment's author
    // clearing the likes on it. The comment doc must still exist for that check,
    // so the client deletes likes before the comment.
    match /commentLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/comments/$(resource.data.commentId)).data.userId == request.auth.uid
      );
    }

    // Book recommendations between members: sender creates; sender or recipient can read;
    // only the recipient updates (accept/dismiss); sender may retract via delete.
    match /recommendations/{recId} {
      allow read: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUserId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.fromUserId == request.auth.uid;
    }

    // Book Blends: one doc per pair (`{uidLow}_{uidHigh}`); only the two participants
    // may read or write. Either side can create (request), respond, or regenerate.
    match /bookBlends/{blendId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null
        && request.resource.data.userIds.size() == 2
        && request.auth.uid in request.resource.data.userIds
        && blendId == request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1];
      allow update: if request.auth != null
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds;
      allow delete: if request.auth != null && request.auth.uid in resource.data.userIds;
    }

    // Dismissed suggestions (Pass): user can only read/write their own passed book IDs
    match /dismissedSuggestions/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Shared cross-user cache of book search results (public catalog metadata).
    // Any signed-in user may fill it — accepted tradeoff: a malicious user could
    // write junk entries; worst case is bad search results for one query for a TTL.
    match /bookSearchCache/{queryHash} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.books is list
        && request.resource.data.books.size() <= 30
        && request.resource.data.source in ['isbndb', 'google', 'openlibrary'];
      allow delete: if false;
    }

    // Community popularity per work (how many members shelved it), maintained
    // solely by the onUserBookWritten Cloud Function (admin SDK bypasses rules).
    match /bookStats/{workHash} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Cross-user cache of user-independent AI content (summary, tags, quote,
    // "about" page, refresher), one doc per book, fields filled lazily. Any
    // signed-in user may fill it — accepted tradeoff (same as bookSearchCache):
    // a malicious user could overwrite a book's cached content. Long-term fix
    // is server-side generation (Cloud Function proxy as the only writer).
    match /aiBookContent/{bookId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['summary', 'tags', 'quote', 'about', 'refresher', 'promptVersion', 'model', 'updatedAt'])
        && request.resource.data.promptVersion is int;
      allow delete: if false;
    }
  }
}
