rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any signed-in reader can read profiles (Other readers strip, feed, library). Write own doc only.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // One doc per lowercase handle: { uid: "<firebase uid>" }.
    // Public read: availability checks must not depend on auth token + rules being deployed per-database;
    // writes are still protected. (Uid per handle is acceptable for a public @handle registry.)
    match /handleClaims/{handle} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Books: read anyone; create/update when authenticated
    match /books/{bookId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // UserBooks: signed-in users can read anyone’s library (viewing tiers/queue). Write own rows only.
    match /userBooks/{userBookId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Posts: read for feed; create when userId == auth.uid; update for likeCount/commentCount
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;  // e.g. likeCount, commentCount
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Comments: read with post; create when authenticated
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Dismissed suggestions (Pass): user can only read/write their own passed book IDs
    match /dismissedSuggestions/{docId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
